NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://app:app@localhost:5432/transaction_event_gateway
REDIS_URL=redis://localhost:6379
WEBHOOK_SECRET=local-development-placeholder-secret
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
OUTBOX_DISPATCH_ENABLED=true
OUTBOX_DISPATCH_INTERVAL_MS=1000
# Reserved/deprecated: transient outbox publish failures retry indefinitely.
OUTBOX_MAX_ATTEMPTS=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_LIMIT=100
SWAGGER_ENABLED=false
